---
import { Image } from 'astro:assets';

interface Props {
  name: string;
  subName?: string;
  description?: string;
  subDesc?: string;
  image?: ImageMetadata;
}

const { name, subName, description, subDesc, image } = Astro.props;
---

<div class="@container">
  <div class="@xl:grid @xl:grid-cols-[auto_1fr] @xl:grid-rows-[auto_1fr] @xl:gap-x-4 px-4">
    <div class="row-span-2 flex justify-center">
      {
        image ? (
          <Image
            src={image}
            alt={name}
            width={150}
            height={225}
            class="w-[150px] h-[225px] rounded-lg mb-2 object-contain hover:scale-105 transition-transform duration-300"
          />
        ) : (
          <div class="w-[150px] h-[225px] bg-gray-300 rounded-lg mb-2" />
        )
      }
    </div>
    <p class="font-itim text-cc-blue text-xl @max-xl:text-center">
      {name}{
        subName && (
          <>
            <br />
            {` ${subName}`}
          </>
        )
      }
      <p class="text-sm text-gray-700 whitespace-pre-line">
        {description}
        {
          subDesc && (
            <>
              <br />
              <br />
              <span class="italic">{subDesc}</span>
            </>
          )
        }
      </p>
    </p>
  </div>
</div>
