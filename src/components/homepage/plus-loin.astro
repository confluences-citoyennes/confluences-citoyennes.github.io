---
import flyer200925 from '../../assets/flyer-200925.jpg';
import flyer131225 from '../../assets/flyer-131225.jpg';
import flyer181025 from '../../assets/flyer-181025.jpg';
import flyer221125 from '../../assets/flyer-221125.jpg';
import flyer230126 from '../../assets/flyer-230126.jpg';
import flyer060326 from '../../assets/flyer-060326.png';
import { Image } from 'astro:assets';
---

<div id="prochain-evenement"></div>
<section class="mb-6">
  <div class="bg-cc-yellow p-4">
    <h2 class="text-black text-3xl text-center">RÉUNION PUBLIQUE - 06 MARS 2026 À 20H</h2>
  </div>

  <div class="p-4 max-w-5xl mx-auto space-y-2">
    <div class="space-y-2 mb-10 md:grid md:grid-cols-2 md:gap-4">
      <div>
        <p class="text-cc-green text-xl mb-2">Prochain évènement</p>
        <p>- Présentation de la liste Confluences Citoyennes</p>
        <p>- Rencontre avec les candidats</p>
        <p>- Détails du programme</p>
        <p class="mt-4 mb-2">
          <strong>Vendredi 06 mars à 20h</strong> - Salle Hervé De Guerdavid
        </p>

        <p>Un espace enfant sera proposé sur place. La réunion sera suivie d'un moment convivial.</p>
      </div>
      <div class="flex justify-center">
        <Image src={flyer060326} alt="réunion publique du 20/09/2025" width={350} class="" />
      </div>
    </div>

    <p class="text-cc-green text-xl">Évènements passés</p>

    <div class="grid grid-cols-5 gap-4">
      <Image
        src={flyer230126}
        alt="atelier public du 23/01/2026"
        width={350}
        class="hover:scale-150 hover:z-10 transition-transform duration-200"
      />
      <Image
        src={flyer131225}
        alt="atelier public du 13/12/2025"
        width={350}
        class="hover:scale-150 hover:z-10 transition-transform duration-200"
      />
      <Image
        src={flyer221125}
        alt="atelier public du 22/11/2025"
        width={350}
        class="hover:scale-150 hover:z-10 transition-transform duration-200"
      />
      <Image
        src={flyer181025}
        alt="atelier public du 18/10/2025"
        width={350}
        class="hover:scale-150 hover:z-10 transition-transform duration-200"
      />
      <Image
        src={flyer200925}
        alt="atelier public du 20/09/2025"
        width={350}
        class="hover:scale-150 hover:z-10 transition-transform duration-200"
      />
    </div>
  </div>
</section>
