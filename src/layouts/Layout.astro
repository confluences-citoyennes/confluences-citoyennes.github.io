---
import '@fontsource/itim';
import itim from '@fontsource/itim/files/itim-latin-400-normal.woff2?url';

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Confluences Citoyennes - Elections municipales Couffouleux',
  description = 'Une liste citoyenne et participative pour les élections municipales 2026 de Couffouleux',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" as="font" type="font/woff2" href={itim} crossorigin="anonymous" />
  </head>
  <body>
    <slot />
  </body>
</html>
